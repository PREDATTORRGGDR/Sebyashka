# ============================================================
#  Себяшка - пример .env. Скопируй в .env и заполни.
#  Всё, что помечено [обязательно], без чего сервис не стартует.
# ============================================================

# ---------- Домен и HTTPS ----------
# [обязательно для прода] домен, куда смотрит A-запись VPS (без https://)
DOMAIN=stickers.example.com
# почта для Let's Encrypt (уведомления об истечении сертификата)
ACME_EMAIL=you@example.com
# [обязательно] публичный адрес = https://$DOMAIN
PUBLIC_URL=https://stickers.example.com
# адрес мини-приложения (по умолчанию = PUBLIC_URL)
# WEBAPP_URL=https://stickers.example.com

# ---------- Telegram-бот ----------
# [обязательно] токен от @BotFather
BOT_TOKEN=123456789:AA...
# username бота без @ (если не указать - возьмётся из getMe)
BOT_USERNAME=sebyashka_bot
# polling - для локалки, webhook - для прода
BOT_MODE=webhook
# [обязательно при webhook] случайная строка 32+ символов: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# твой Telegram ID (узнать у @userinfobot), через запятую. Админы получают:
#  вкладку «Админ» в мини-приложении, генерацию без списания, алерты, команды /admin /alerts /user /grant /refund /ban
ADMIN_IDS=
# username аккаунта поддержки без @
SUPPORT_USERNAME=
# Какие алерты слать админам (у каждого админа можно выключить кнопками в /alerts)
ADMIN_ALERTS=new_user,invoice,payment,pack_created,pack_ready,pack_failed,system
# Необязательно: группа для алертов (бот должен быть в ней), например -1001234567890
ADMIN_CHAT_ID=

# ---------- База данных ----------
POSTGRES_USER=sebyashka
# [обязательно] openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=sebyashka
# Для docker compose DATABASE_URL собирается автоматически. Для локального запуска без Docker:
# DATABASE_URL=postgres://sebyashka:пароль@localhost:5432/sebyashka

# ---------- Безопасность ----------
# [обязательно] openssl rand -hex 32  (подпись ссылок на превью стикеров)
SIGNING_SECRET=

# ---------- Оплата: CryptoBot ----------
# @CryptoBot → Crypto Pay → Create App → API Token. Пусто = крипта выключена.
CRYPTOBOT_TOKEN=
# testnet - для проверки (@CryptoTestnetBot), mainnet - боевой
CRYPTOBOT_NETWORK=mainnet
CRYPTOBOT_ASSETS=USDT,TON,BTC,ETH,LTC,TRX,USDC

# ---------- ИИ-генерация ----------
# Провайдер ещё не выбран - сравнение и расчёты в docs/STRATEGY.md.
# mock - без ИИ (заглушки для тестов), fal - fal.ai, replicate - Replicate
GEN_PROVIDER=mock
FAL_KEY=
FAL_MODEL=fal-ai/flux-pulid
# Необязательно: свой JSON-шаблон входа модели. Плейсхолдеры: {{prompt}} {{negative_prompt}} {{image_url}} {{seed}}
# FAL_INPUT_TEMPLATE={"prompt":"{{prompt}}","reference_image_url":"{{image_url}}","seed":"{{seed}}","image_size":"square"}
# REPLICATE_TOKEN=
# REPLICATE_MODEL=owner/model или owner/model:version
# REPLICATE_INPUT_TEMPLATE=
# Удаление фона: local (бесплатно, по белому фону), fal (нейросеть, точнее, ~$0.002/стикер), none
BG_REMOVAL=local
FAL_BG_MODEL=fal-ai/birefnet
GEN_TIMEOUT_SEC=180

# ---------- Продукт ----------
STICKERS_PER_PACK=16
FREE_PACK_SIZE=6
# сколько стикеров одного пака генерировать параллельно
GEN_CONCURRENCY=3
# сколько паков один воркер собирает одновременно
WORKER_SLOTS=2
# через сколько часов удалять селфи
SELFIE_TTL_HOURS=24
MAX_UPLOAD_MB=10
# если удачных стикеров меньше этой доли - пак проваливается и кредиты возвращаются
MIN_SUCCESS_RATIO=0.7

LOG_LEVEL=info
